# n8n local configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# PDF Signer service URL used by n8n
# Local Docker Compose value:
PDF_SIGNER_URL=http://pdf-signer:8000/sign

# Timezone
GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw

# Gmail OAuth credentials are configured inside n8n.
# Do not paste Gmail secrets here.

# OpenAI API credentials are configured inside n8n.
# Do not paste OpenAI secrets here.

# Production example after deploying PDF Signer:
# PDF_SIGNER_URL=https://your-pdf-signer-domain.example.com/sign