# Gmail / Google OAuth credentials
# Do not paste real Gmail secrets into this example file.
# Configure Gmail credentials inside the n8n Credentials UI for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq OpenAI-compatible API
# Get your API key from the Groq Console.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# PDF Signer service
# Inside Docker Compose, n8n calls the pdf-signer service by its service name.
PDF_SIGNER_URL=http://pdf-signer:8000/sign

# n8n local settings
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw

# Security note:
# Never commit a real .env file, API keys, OAuth tokens, or signature image files.