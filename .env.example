# Gmail / Google OAuth credentials
# Do not paste real Gmail secrets into this example file.
# In the final deployment, configure Gmail credentials directly inside Piotr's n8n Credentials UI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq OpenAI-compatible API
# Get your API key from the Groq Console.
# In the final deployment, configure this directly inside Piotr's n8n Credentials UI.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# PDF Signer service
# Final deployed Coolify public endpoint used by the n8n workflow.
PDF_SIGNER_URL=http://ummu-internship-pdf-signer.codewithpeter.com/sign

# Local development n8n settings
# These are only needed when running n8n locally with Docker Compose.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw

# Security note:
# Never commit a real .env file, API keys, OAuth tokens, client secrets, or personal signature images.